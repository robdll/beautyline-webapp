# MongoDB
MONGODB_URI=mongodb://localhost:27017/beautyline
# Optional: for `npm run seed:sync:from-prod` — prod read + local write (never commit real URIs)
# MONGODB_URI_PROD=mongodb+srv://...
# MONGODB_URI_LOCAL=mongodb://localhost:27017/beautyline

# Local seed (development only)
ENABLE_LOCAL_SEED=false
LOCAL_SEED_ADMIN_EMAIL=admin@beautyline.local
LOCAL_SEED_ADMIN_PASSWORD=Password123!

# JWT Auth
JWT_SECRET=change-me-to-a-random-string
JWT_REFRESH_SECRET=change-me-to-another-random-string

# App URL
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Google Ads (gtag.js) — loaded only after cookie consent "Tutti"
NEXT_PUBLIC_GOOGLE_ADS_ID=your-google-tag
# From Google Ads → Goals → Conversions → tag setup event snippet `send_to`
NEXT_PUBLIC_GOOGLE_ADS_COURSE_INFO_CONVERSION_SEND_TO=conversion

# Resend (email)
RESEND_API_KEY=re_xxxxxxxxxxxx
CONTACT_FROM_EMAIL=noreply@beautylineprofessional.com
CONTACT_TO_EMAIL=info@beautylineprofessional.com

# Cloudinary (media uploads)
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# Stripe (payments)
STRIPE_SECRET_KEY=sk_test_xxxxxxxxxxxx
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_xxxxxxxxxxxx

# Google Places (public reviews)
GOOGLE_PLACES_API_KEY=AIzaSyxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
GOOGLE_PLACES_PLACE_ID=ChIJLckVgZe5hkcRGDgYrtmimC8
